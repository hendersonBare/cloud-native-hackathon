# Copy to .env (gitignored) and fill in. Placeholders only; never commit real values.
OPENAI_API_KEY=<your-openai-api-key>
# Optional: Claude for the agents. When set, `make secrets` adds it to the `openai` Secret next to OPENAI_API_KEY.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
RAPPORT_LLM_MODEL=gpt-6-luna
RAPPORT_LLM_REASONING_EFFORT=low

# Elastic Cloud (Serverless Elasticsearch project)
ES_URL=https://<your-project>.es.<region>.elastic.cloud:443
ES_ADMIN_API_KEY=<admin key: laptop only, used by setup-elastic.sh and make seed>
ES_BRIEFER_KEY_ACME=<encoded key from role-descriptors/briefer-acme.json>
ES_BRIEFER_KEY_BLUEFIN=<encoded key from role-descriptors/briefer-bluefin.json>
ES_DELEGATE_KEY_ACME=<encoded key from role-descriptors/delegate-acme.json>
ES_DELEGATE_KEY_BLUEFIN=<encoded key from role-descriptors/delegate-bluefin.json>
# Optional: force the semantic_text inference endpoint
# ES_INFERENCE_ID=.jina-embeddings-v5-text-small

# Dash0
DASH0_OTLP_ENDPOINT=https://ingress.<region>.aws.dash0.com:4318
DASH0_AUTH_TOKEN=<your-dash0-auth-token>
# Website monitoring (optional). Every browser receives this token: create a SEPARATE Dash0 auth token with
# only the Ingesting permission, limited to one dataset. Never reuse DASH0_AUTH_TOKEN here.
# The endpoint is the "OTLP via HTTP" URL; it defaults to DASH0_OTLP_ENDPOINT.
DASH0_RUM_AUTH_TOKEN=
DASH0_RUM_ENDPOINT=
DASH0_RUM_DATASET=

# Local dev without Kubernetes (optional)
# GATEWAY_URL=http://localhost:8080
# BRIEFER_URL_ACME=http://localhost:8101
# BRIEFER_URL_BLUEFIN=http://localhost:8102
# OPA_URL_ACME=http://localhost:8181
# OPA_URL_BLUEFIN=http://localhost:8182
